{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'__NODE__' '__ADAPTER__' --hook '__HOOK__' --hook-sha256-file '__HOOK_SHA256_FILE__' --host '__HOST_ID__'",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'__NODE__' '__ADAPTER__' --hook '__HOOK__' --hook-sha256-file '__HOOK_SHA256_FILE__' --host '__HOST_ID__'",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'__NODE__' '__ADAPTER__' --hook '__HOOK__' --hook-sha256-file '__HOOK_SHA256_FILE__' --host '__HOST_ID__'",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'__NODE__' '__ADAPTER__' --hook '__HOOK__' --hook-sha256-file '__HOOK_SHA256_FILE__' --host '__HOST_ID__'",
            "timeout": 3
          }
        ]
      }
    ]
  }
